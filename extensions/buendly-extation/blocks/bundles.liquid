{% render 'bundle-options', product: product, block: block %}
{% schema %}
{
  "name": "Bundlify bundles",
  "target": "section",
  "javascript": "bundlify-bundles.js",
  "stylesheet": "bundlify-bundles.css",
  "settings": [{ "type": "checkbox", "id": "match_product", "label": "Only show bundles containing this product", "default": false }, { "type": "text", "id": "heading", "label": "Heading", "default": "Better together" }]
}
{% endschema %}
