{% comment %}Preserve the installed block handle while separating bundles from subscriptions.{% endcomment %}
{% render 'bundle-options', product: product, block: block %}
{% schema %}
{
  "name": "Bundle offers",
  "target": "section",
  "javascript": "bundlify-bundles-loader.js",
  "stylesheet": "bundlify-bundles.css",
  "settings": [
    { "type": "checkbox", "id": "match_product", "label": "Only show bundles containing this product", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better together" },
    { "type": "paragraph", "content": "Manage eligible custom bundle products in the Bundlify app under Bundles → Manage custom bundle products." }
  ]
}
{% endschema %}
