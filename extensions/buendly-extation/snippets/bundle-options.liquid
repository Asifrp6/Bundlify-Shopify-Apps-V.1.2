{% assign appearance = shop.metafields.bundlify.bundle_appearance.value %}
{% assign custom_bundle_products = shop.metafields.bundlify.custom_bundle_products.value %}
{{ 'bundlify-bundles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bundlify-bundles.js' | asset_url }}" defer></script>
{% render 'block-appearance', kind: 'bundle', appearance: appearance %}
<bundlify-bundles data-button-text="{{ appearance.buttonText | default: 'Add bundle to cart' | escape }}" data-currency="{{ cart.currency.iso_code }}" data-root="{{ routes.root_url }}" data-product="{% if block.settings.match_product %}{{ product.id }}{% endif %}" data-editor="{{ request.design_mode }}" hidden {{ block.shopify_attributes }}>
  {% if appearance.logoUrl != blank %}<img class="bundlify-custom-logo" src="{{ appearance.logoUrl | escape }}" alt="{{ shop.name | escape }}" width="160" height="80">{% endif %}
  <h2>{{ appearance.heading | default: block.settings.heading | default: 'Better together' | escape }}</h2>
  <div class="bundlify-mode-cards" role="group" aria-label="Choose your bundle">
    <button type="button" class="bundlify-mode-card" data-preset-toggle aria-pressed="true" aria-controls="bundlify-ours-{{ block.id }}">
      <svg aria-hidden="true" viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="18" width="34" height="9" rx="2"/><path d="M10 27v14h28V27M24 18v23M24 18H16a5 5 0 1 1 5-7l3 7Zm0 0h8a5 5 0 1 0-5-7l-3 7Z"/></svg>
      <strong>Our bundle</strong><small>Ready-made combinations for you</small>
    </button>
    <button type="button" class="bundlify-mode-card" data-custom-toggle aria-haspopup="dialog" aria-pressed="false" aria-expanded="false" aria-controls="bundlify-custom-{{ block.id }}" {% unless custom_bundle_products.count >= 2 %}disabled{% endunless %}>
      <svg aria-hidden="true" viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="6" y="6" width="14" height="14" rx="3"/><rect x="28" y="6" width="14" height="14" rx="3"/><rect x="6" y="28" width="14" height="14" rx="3"/><path d="M35 27v16M27 35h16"/></svg>
      <strong>Custom bundle</strong><small>{% if custom_bundle_products.count >= 2 %}Pick your favorites. Make it yours.{% else %}Not available yet{% endif %}</small>
    </button>
  </div>
  <div id="bundlify-ours-{{ block.id }}" data-preset-panel>
  <div data-list></div>
  <p data-message role="status"></p>
  </div>
  {% if custom_bundle_products.count >= 2 %}
    <div data-custom-bundle data-custom-discount="{{ shop.metafields.bundlify.custom_bundle_discount.value.percentage | default: 0 }}">
      <dialog id="bundlify-custom-{{ block.id }}" class="bundlify-builder-dialog" data-custom-dialog aria-labelledby="bundlify-custom-title-{{ block.id }}">
        <button type="button" class="bundlify-builder-close" data-custom-close aria-label="Close custom bundle" autofocus>Close <span aria-hidden="true">×</span></button>
      <article data-custom-picker hidden>
        <h3 id="bundlify-custom-title-{{ block.id }}">Create your bundle</h3>
        <p>Select at least 2 different products. Your bundle savings will apply in the cart.</p>
      </article>
      </dialog>
      <div data-custom-products hidden>
        {% for eligible_product in custom_bundle_products %}
          <span data-handle="{{ eligible_product.handle | escape }}" data-title="{{ eligible_product.title | escape }}"></span>
        {% endfor %}
      </div>
    </div>
  {% elsif request.design_mode %}
    <p>Open the Bundlify app → Bundles → Manage custom bundle products and save at least 2 products to enable Create custom bundle.</p>
  {% endif %}
</bundlify-bundles>
