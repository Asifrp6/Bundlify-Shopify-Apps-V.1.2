{% comment %}
  Both blocks always use the theme's fonts. Colors follow the theme (see the store-match tokens in the block CSS)
  unless the merchant turned "Match my store's font and colors" off in Settings. Settings saved before that switch
  existed keep matching the store only while every color is still an app default (mirrors resolveMatchStore in
  app/services/appearance.js, including its list of shipped default colors).
{% endcomment %}
{%- liquid
  assign font_size = appearance.fontSize | default: 16 | plus: 0 | at_least: 12 | at_most: 24
  if kind == 'bundle'
    assign typography_selector = 'bundlify-bundles'
  else
    assign typography_selector = 'bundlify-subscription.bundlify-subscription-widget'
  endif
  assign match_store = true
  if appearance != blank
    if appearance.matchStore == false
      assign match_store = false
    elsif appearance.matchStore == nil
      assign known_colors = '|#ffffff|#f1f3f8|#0e1b3d|#20382b|#0a1435|#0a6ff0|#285c43|#020b3f|#e1e4e8|#f1f5f3|#fafcfb|#525a64|#dfe2e7|#edf0f4|#243c5c|#b2bcca|#e1e7ef|#0550d8|#8193aa|#d5dde8|#6e819b|#375c8d|#e1e8e4|#52645b|#dfe7e2|#edf4ef|#2e5140|#b2cabc|#e1efe6|#234e38|#81aa90|#d5e8dc|#6e9b7e|#477d5c|'
      assign color_keys = 'background,text,accent,buttonTextColor,borderColor,groupBackground,cardBackground,cardText,cardBorder,hoverBackground,hoverText,hoverBorder,selectedBackground,selectedText,selectedBorder,selectedHoverBackground,selectedHoverText,selectedHoverBorder,iconColor,selectedIconColor,hoverIconColor,focusColor' | split: ','
      for color_key in color_keys
        assign saved_color = appearance[color_key] | downcase
        if saved_color != blank
          assign probe = '|' | append: saved_color | append: '|'
          unless known_colors contains probe
            assign match_store = false
            break
          endunless
        endif
      endfor
    endif
  endif
-%}
<style>
  {{ typography_selector }} {
    --bundlify-font-scale: {{ font_size | divided_by: 16.0 }};
    font-size: {{ font_size }}px;
    line-height: 1.5;
  }
  {{ typography_selector }} > h2 { font-size:calc(24px * var(--bundlify-font-scale)); }
  bundlify-subscription.bundlify-subscription-widget > h3 { font-size:calc(20px * var(--bundlify-font-scale, 1)); }
  .bundlify-custom-logo { display:block; max-width:160px; height:80px; object-fit:contain; margin-bottom:16px; }
{%- unless match_store %}
  {{ typography_selector }} {
    --bl-borderColor: {{ appearance.borderColor | default: '#e1e4e8' | escape }};
    --bl-groupBackground: {{ appearance.groupBackground | default: '#f1f5f3' | escape }};
    --bl-cardBackground: {{ appearance.cardBackground | default: '#fafcfb' | escape }};
    --bl-cardText: {{ appearance.cardText | default: '#525a64' | escape }};
    --bl-cardBorder: {{ appearance.cardBorder | default: '#dfe2e7' | escape }};
    --bl-hoverBackground: {{ appearance.hoverBackground | default: '#edf0f4' | escape }};
    --bl-hoverText: {{ appearance.hoverText | default: '#243c5c' | escape }};
    --bl-hoverBorder: {{ appearance.hoverBorder | default: '#b2bcca' | escape }};
    --bl-selectedBackground: {{ appearance.selectedBackground | default: '#e1e7ef' | escape }};
    --bl-selectedText: {{ appearance.selectedText | default: '#0550d8' | escape }};
    --bl-selectedBorder: {{ appearance.selectedBorder | default: '#8193aa' | escape }};
    --bl-selectedHoverBackground: {{ appearance.selectedHoverBackground | default: '#d5dde8' | escape }};
    --bl-selectedHoverText: {{ appearance.selectedHoverText | default: '#0550d8' | escape }};
    --bl-selectedHoverBorder: {{ appearance.selectedHoverBorder | default: '#6e819b' | escape }};
    --bl-iconColor: {{ appearance.iconColor | default: '#525a64' | escape }};
    --bl-selectedIconColor: {{ appearance.selectedIconColor | default: '#0550d8' | escape }};
    --bl-hoverIconColor: {{ appearance.hoverIconColor | default: '#243c5c' | escape }};
    --bl-focusColor: {{ appearance.focusColor | default: '#375c8d' | escape }};
    --bundlify-action-background: {{ appearance.accent | escape }};
    --bundlify-action-text: {{ appearance.buttonTextColor | escape }};
    padding: clamp(16px, 3vw, 28px);
    border: 1px solid var(--bl-borderColor);
    border-radius: 24px;
    background: {{ appearance.background | escape }};
    color: {{ appearance.text | escape }};
  }
  {{ typography_selector }} > :is(h2,h3), {{ typography_selector }} legend { color:inherit; }
  {%- if kind == 'bundle' %}
  bundlify-bundles .bundlify-mode-cards.bundlify-mode-cards { padding:6px; border-radius:22px; }
  .bundlify-cart-drawer { --bundlify-action-background: {{ appearance.accent | escape }}; --bundlify-action-text: {{ appearance.buttonTextColor | escape }}; }
  bundlify-bundles article { background:{{ appearance.background | escape }}; color:{{ appearance.text | escape }}; }
  bundlify-bundles .bundlify-product-price strong, bundlify-bundles .bundlify-total strong { color:{{ appearance.accent | escape }}; }
  {%- else %}
  bundlify-subscription.bundlify-subscription-widget[data-variant-id] .bundlify-purchase-cards { padding:6px; border-radius:22px; }
  bundlify-subscription.bundlify-subscription-widget[data-variant-id] .bundlify-price,
  bundlify-subscription.bundlify-subscription-widget[data-variant-id] .bundlify-purchase-card > strong { color:inherit; }
  {%- endif %}
{%- endunless %}
</style>
