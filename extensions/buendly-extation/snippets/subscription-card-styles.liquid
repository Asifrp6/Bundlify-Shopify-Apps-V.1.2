{% comment %}Keep the core card layout available during theme editor section reloads. Colors and fonts come from the theme.{% endcomment %}
<style>
  bundlify-subscription.bundlify-subscription-widget {
    display: block; width: 100%; max-width: 620px; margin: 24px auto;
    padding: 0; border-radius: 0; color: inherit; background: none;
    box-sizing: border-box; font-family: var(--font-body-family, inherit); line-height: 1.5;
  }
  bundlify-subscription.bundlify-subscription-widget * { box-sizing: border-box; }
  bundlify-subscription.bundlify-subscription-widget fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  bundlify-subscription.bundlify-subscription-widget [hidden] { display: none !important; }
  bundlify-subscription.bundlify-subscription-widget legend { font-size:calc(14px * var(--bundlify-font-scale, 1)); padding: 0; margin-bottom: 14px; }
  bundlify-subscription.bundlify-subscription-widget .bundlify-purchase-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  bundlify-subscription.bundlify-subscription-widget .bundlify-purchase-card {
    position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); align-content: center; align-items: center;
    column-gap: 12px; row-gap: 2px; padding: 13px 42px 13px 13px;
    margin: 0; border: 1px solid color-mix(in srgb, currentColor 14%, transparent); border-radius: 16px;
    background: transparent; color: inherit; text-align: left; cursor: pointer;
  }
  bundlify-subscription.bundlify-subscription-widget .bundlify-purchase-card > input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  bundlify-subscription.bundlify-subscription-widget .bundlify-card-icon { grid-row: 1 / span 3; grid-column: 1; }
  bundlify-subscription.bundlify-subscription-widget .bundlify-purchase-card > :is(.bundlify-card-title, small, strong) { grid-column: 2; justify-self: start; }
  bundlify-subscription.bundlify-subscription-widget .bundlify-card-icon svg { display: block; }
  bundlify-subscription.bundlify-subscription-widget .bundlify-purchase-card small { display: block; font-size:calc(13px * var(--bundlify-font-scale, 1)); }
  bundlify-subscription.bundlify-subscription-widget .bundlify-purchase-card[aria-disabled="true"] { opacity: .5; cursor: not-allowed; }
  bundlify-subscription.bundlify-subscription-widget .bundlify-option { display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: 12px; cursor: pointer; }
  bundlify-subscription.bundlify-subscription-widget .bundlify-plan-copy { flex: 1; }
</style>
