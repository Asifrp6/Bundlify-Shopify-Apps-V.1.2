{{ 'bundlify-subscription.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bundlify-subscription.js' | asset_url }}" defer></script>
{% render 'subscription-card-styles' %}
{% assign appearance = shop.metafields.bundlify.subscription_appearance.value %}
{% render 'block-appearance', kind: 'subscription', appearance: appearance %}
{% assign selected_variant = product.selected_or_first_available_variant %}

<bundlify-subscription data-variant-id="{{ selected_variant.id }}" class="bundlify-subscription-widget" {{ block.shopify_attributes }}>
  {% if appearance.logoUrl != blank %}<img class="bundlify-custom-logo" src="{{ appearance.logoUrl | escape }}" alt="{{ shop.name | escape }}" width="160" height="80">{% endif %}
  <h3>{{ appearance.heading | default: 'Purchase options' | escape }}</h3>
  {% if product != blank %}
      {% for variant in product.variants %}
        <fieldset data-bundlify-plans="{{ variant.id }}" data-available="{{ variant.available }}"
          {% unless variant.id == selected_variant.id %}hidden disabled{% endunless %}>
          <legend>{{ appearance.purchaseHint | default: 'Choose how to purchase' | escape }}</legend>
          <div class="bundlify-purchase-cards">
            {% unless variant.requires_selling_plan %}
              <label class="bundlify-purchase-card">
                <input type="radio" data-mode name="mode-{{ block.id }}-{{ variant.id }}" value="one-time" checked>
                <span class="bundlify-card-icon" aria-hidden="true">
                  {% render 'appearance-icon', name: appearance.oneTimeIcon, fallback: 'box' %}
                </span>
                <span class="bundlify-card-title">{{ appearance.oneTimeText | default: 'One-time purchase' | escape }}</span>
                <small>{{ appearance.oneTimeDescription | default: 'Buy once, without a subscription' | escape }}</small>
                <strong>{{ variant.price | money_with_currency }}</strong>
              </label>
            {% endunless %}
              <label class="bundlify-purchase-card" {% if variant.selling_plan_allocations.size == 0 %}aria-disabled="true"{% endif %}>
                <input type="radio" data-mode name="mode-{{ block.id }}-{{ variant.id }}" value="subscription"
                  {% if variant.selling_plan_allocations.size == 0 %}disabled{% endif %}
                  {% if variant.requires_selling_plan %}checked{% endif %}>
                <span class="bundlify-card-icon" aria-hidden="true">
                  {% render 'appearance-icon', name: appearance.subscriptionIcon, fallback: 'repeat' %}
                </span>
                <span class="bundlify-card-title">{{ appearance.buttonText | default: 'Subscribe & Save' | escape }}</span>
                {% if variant.selling_plan_allocations.size > 0 %}
                <small>{{ appearance.subscriptionDescription | default: 'Choose your delivery schedule' | escape }}</small>
                {% else %}
                <small>{{ appearance.subscriptionUnavailableText | default: 'No subscription available for this option' | escape }}</small>
                {% endif %}
              </label>
          </div>
          <div data-frequencies {% unless variant.requires_selling_plan %}hidden{% endunless %}>
            <p class="bundlify-eyebrow">DELIVERY FREQUENCY</p>
            {% for allocation in variant.selling_plan_allocations %}
              <label class="bundlify-option">
                <input type="radio" data-plan name="plan-{{ block.id }}-{{ variant.id }}" value="{{ allocation.selling_plan.id }}" {% if forloop.first %}checked{% endif %}>
                <span class="bundlify-plan-copy">
                  <span>{{ allocation.selling_plan.name | escape }}</span>
                  {% if variant.price > allocation.price and variant.price > 0 %}
                    {% assign saving = variant.price | minus: allocation.price | times: 100.0 | divided_by: variant.price | round %}
                    <small>Save {{ saving }}%</small>
                  {% endif %}
                </span>
                <span class="bundlify-price">{{ allocation.price | money_with_currency }}<small> / delivery</small></span>
              </label>
            {% endfor %}
            <details><summary>Subscription details</summary><p>You are choosing recurring deliveries at the selected frequency. Review the payment schedule and subscription terms at checkout.</p></details>
          </div>
        </fieldset>
      {% endfor %}
      <p data-bundlify-error role="status" hidden></p>
      <noscript>Enable JavaScript to select a subscription.</noscript>
  {% else %}
    <p>Select a product to preview its purchase options.</p>
  {% endif %}
</bundlify-subscription>
